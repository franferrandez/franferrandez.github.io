---
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import Analytics from "@components/Analytics.astro";
import { getLangFromUrl, useContent, localizedPath } from "@i18n/utils";
import { languages, profile } from "@i18n/ui";

interface Props {
  title: string;
  description: string;
  /** Página principal: activa la intro, hreflang y los datos estructurados */
  home?: boolean;
  noindex?: boolean;
}

const { title, description, home = false, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const c = useContent(lang);
const site = Astro.site ?? new URL("https://franferrandez.github.io");
const canonical = new URL(home ? localizedPath(lang) : Astro.url.pathname, site);
const ogImage = new URL("/og.png", site);
const locale = { es: "es_ES", en: "en_US" }[lang];

// Datos estructurados para que Google sepa quién es el autor del sitio
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": new URL("/#person", site).href,
      name: "Francisco Ferrández Martínez",
      alternateName: profile.name,
      url: site.href,
      jobTitle: c.seo.jobTitle,
      description: c.meta.description,
      email: `mailto:${profile.email}`,
      worksFor: {
        "@type": "GovernmentOrganization",
        name: "Gerencia Informática de la Seguridad Social",
        alternateName: "GISS",
      },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Universidad de Alicante",
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Castellón de la Plana",
        addressCountry: "ES",
      },
      knowsAbout: ["Java", "Spring Boot", ".NET", "C#", "Azure", "Angular", "Jenkins", "CI/CD", "SQL Server"],
      knowsLanguage: ["es", "ca", "en"],
      sameAs: [profile.linkedin, profile.github],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", site).href,
      url: site.href,
      name: profile.name,
      inLanguage: ["es", "en"],
      author: { "@id": new URL("/#person", site).href },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Francisco Ferrández Martínez" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      home &&
        languages.map((l) => (
          <link rel="alternate" hreflang={l.code} href={new URL(localizedPath(l.code), site)} />
        ))
    }
    {home && <link rel="alternate" hreflang="x-default" href={new URL("/", site)} />}

    <meta property="og:type" content={home ? "profile" : "website"} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.seo.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/franferrandez.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline define:vars={{ home }}>
      // Aplica el tema antes de pintar para evitar parpadeos
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let theme = null;
        try { theme = localStorage.getItem("theme"); } catch {}
        if (!theme) theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        root.classList.toggle("dark", theme === "dark");
        if (!home) return;

        // Intro con el logo: una vez por sesión y nunca con movimiento reducido
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let seen = true;
        try {
          seen = sessionStorage.getItem("intro-seen") === "1";
          sessionStorage.setItem("intro-seen", "1");
        } catch {}
        if (!reduced && !seen) root.classList.add("intro");
        if (!reduced) root.classList.add("typing");
      })();
    </script>
    <Analytics />
  </head>
  <body class="bg-bg font-sans text-fg antialiased selection:bg-accent/30">
    <slot />

    <script>
      // Animación de aparición al hacer scroll
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      // Los elementos del hero los muestra la máquina de escribir al terminar
      document.querySelectorAll("[data-reveal]:not([data-after-type])").forEach((el) => {
        // Lo que ya está en pantalla al cargar se muestra sin esperar al observer
        if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add("is-visible");
        else reveal.observe(el);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: 250 250 249;
    --surface: 255 255 255;
    --fg: 28 25 23;
    --muted: 99 94 89;
    --line: 228 225 222;
    --accent: 180 83 9;
    color-scheme: light;
  }

  .dark {
    --bg: 10 10 10;
    --surface: 21 20 19;
    --fg: 245 245 244;
    --muted: 163 158 153;
    --line: 41 38 36;
    --accent: 251 191 36;
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  body {
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* Solo se ocultan si hay JS: sin JS el contenido se ve igual */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0ms);
  }

  .js [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  @media print {
    .js [data-reveal] {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .js [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
