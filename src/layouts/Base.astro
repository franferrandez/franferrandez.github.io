---
import Header from "@components/Header.astro";
import Body from "@components/Body.astro";
import Footer from "@components/Footer.astro";
import { getLangFromUrl } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio Francisco Ferrández" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/franferrandez.svg" />
    <title>franferrandez</title>
  </head>
  <body
    class="text-amber-800 transition-colors duration-300 bg-amber-50 dark:bg-amber-400"
  >
    <Header />
    <Body />
    <Footer />
  </body>
</html>

<style is:global>
  /* Estilos base */
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }
</style>
