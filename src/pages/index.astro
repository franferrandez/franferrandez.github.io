---
import { defaultLang } from '@i18n/ui';
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio Francisco Ferrández" />
    <link rel="icon" type="image/svg+xml" href="/franferrandez.svg" />
    <title>franferrandez</title>
    <meta http-equiv="refresh" content={`0;url=/${defaultLang}/`} />
  </head>
  <body>
    <!-- Opcionalmente puedes mostrar un mensaje aquí -->
    <noscript>
      Si no se redirige automáticamente, <a href={`/${defaultLang}/`}>haga clic aquí</a>.
    </noscript>
  </body>
</html>
