---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import { content } from "@i18n/ui";

// GitHub Pages sirve este único 404.html para todo; el idioma se ajusta en el cliente
const es = content.es.notFound;
const en = content.en.notFound;
---

<Layout title={es.title} description={es.description} noindex>
  <main class="relative isolate grid min-h-[100svh] place-items-center overflow-hidden px-5 text-center">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <div>
      <a href="/" class="mx-auto mb-10 block w-fit" aria-label="Francisco Ferrández">
        <Icon name="franferrandez" class="h-12 w-12 text-accent" />
      </a>
      <p class="font-mono text-sm text-accent">404</p>
      <h1 class="mt-4 text-[clamp(2.25rem,7vw,4.5rem)] font-bold leading-none tracking-[-0.04em]">
        <span data-i18n="heading">{es.heading}</span><span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="mx-auto mt-6 max-w-md text-lg text-muted" data-i18n="text">{es.text}</p>
      <p class="mt-4 font-mono text-xs text-muted/80" data-path></p>
      <a
        href="/"
        data-home
        class="group mt-10 inline-flex items-center gap-2 rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition-transform hover:-translate-y-0.5"
      >
        <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
        <span data-i18n="cta">{es.cta}</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .grid-bg {
    background-image:
      linear-gradient(rgb(var(--line) / 0.7) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--line) / 0.7) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, black 20%, transparent 75%);
  }

  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.8em;
    margin-left: 0.08em;
    vertical-align: -0.04em;
    border-radius: 2px;
    background: rgb(var(--accent));
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ en }}>
  // Ruta que no existe, mostrada como si fuera una terminal
  const path = document.querySelector("[data-path]");
  if (path) path.textContent = `$ cd ${decodeURI(location.pathname)}: no such file or directory`;

  if (location.pathname.startsWith("/en/")) {
    document.documentElement.lang = "en";
    document.title = en.title;
    document.querySelectorAll("[data-i18n]").forEach((el) => (el.textContent = en[el.dataset.i18n]));
    document.querySelector("[data-home]")?.setAttribute("href", "/en/");
  }
</script>
