---
import { getLangFromUrl, useContent } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { footer } = useContent(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-page flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-muted md:flex-row md:px-8"
  >
    <p>© {year} {footer.rights}</p>
    <p class="font-mono text-xs">{footer.built}</p>
    <a href="#top" class="transition-colors hover:text-fg">{footer.top} ↑</a>
  </div>
</footer>
