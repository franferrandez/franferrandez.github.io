---
import Toggle from "./Toggle.astro";
import { Icon } from "astro-icon/components";
import LanguageDropdown from "./LanguageDropdown.astro";
---

<header
  class="pt-1 pb-1 bg-amber-200 text-amber-800 dark:bg-amber-300 dark:text-amber-950 shadow-md"
>
  <section class="ml-10 mr-10 mb-3">
    <div class="flex items-center justify-between mt-2">
      <a href="/" class="flex items-center gap-4 logo">
        <!-- Envolvemos en un <a> -->
        <!-- <img class="w-16 h-16" src="./img/franferrandez.png" alt="icon" /> -->
        <Icon name="franferrandez" class="w-12 h-12 hover:size-2" />
        <div class="flex flex-col">
          <h1 class="text-2xl font-mono font-semibold">FRANCISCO</h1>
          <h1 class="text-xs font-mono">FERRÁNDEZ MARTÍNEZ</h1>
        </div>
      </a>
      <div class="flex movil gap-3 items-center">
        <div class="flex gap-2 items-center">
          <a
            href="https://github.com/franferrandez"
            target="_blank"
            rel="noreferrer nopener"
            ><Icon
              name="github"
              class="w-6 h-6 hover:text-amber-950 dark:hover:text-amber-800"
            /></a
          >
          <a href="mailto:franciscoferrandezmartinez@gmail.com"
            ><Icon
              name="mail"
              class="w-6 h-6 hover:text-amber-950 dark:hover:text-amber-800"
            /></a
          >
          <a
            href="https://www.linkedin.com/in/franferrandez/"
            target="_blank"
            rel="noreferrer nopener"
            ><Icon
              name="linkedin"
              class="w-6 h-6 hover:text-amber-950 dark:hover:text-amber-800"
            /></a
          >
        </div>
        <span class="separator">|</span>
        <Toggle />
        <span class="separator">|</span>
        <LanguageDropdown />
      </div>
      <Icon id="menuToggle" name="menu" />
    </div>
  </section>

  <!-- Menú desplegable en móviles (oculto inicialmente) -->
  <section
    id="mobileMenu"
    class="pt-2 pb-4 pl-16 pr-16 bg-amber-200 text-amber-800 dark:bg-amber-300 dark:text-amber-950 shadow-md"
  >
    <div class="flex justify-between">
      <div class="flex gap-2">
        <a
          href="https://github.com/franferrandez"
          target="_blank"
          rel="noreferrer nopener"
          ><Icon
            name="github"
            class="w-6 h-6 hover:text-amber-950 dark:hover:text-amber-800"
          /></a
        >
        <a href="mailto:franciscoferrandezmartinez@gmail.com"
          ><Icon
            name="mail"
            class="w-6 h-6 hover:text-amber-950 dark:hover:text-amber-800"
          /></a
        >
        <a
          href="https://www.linkedin.com/in/franferrandez/"
          target="_blank"
          rel="noreferrer nopener"
          ><Icon
            name="linkedin"
            class="w-6 h-6 hover:text-amber-950 dark:hover:text-amber-800"
          /></a
        >
      </div>
      <div class="flex gap-2 items-normal">
        <Toggle />
        <LanguageDropdown />
      </div>
    </div>
  </section>
</header>
<!-- <hr class="bg-white "/> -->

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    corner-shape: bevel;
    border-bottom-right-radius: 5% 25px;
  }

  hr {
    width: 100%;
  }

  [data-icon] {
    font-size: 2rem;
  }

  .logo {
    user-select: none; /* Evita que el texto sea seleccionable */
    text-decoration: none; /* Elimina el subrayado predeterminado del enlace */
  }

  .logo h1 {
    color: inherit; /* Asegura que el color del texto se mantenga igual */
  }

  #menuToggle {
    display: none;
  }

  #mobileMenu {
    position: absolute; /* posicionado relativo al header */
    left: 0;
    right: 0;
    top: 100%; /* justo debajo del header */
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    max-height: 0;
    overflow: hidden;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      max-height 0.35s ease;

    corner-shape: bevel;
    border-bottom-right-radius: 10% 50px;
    width: 95%;
  }

  .separator {
    margin: 0 0.5rem;
  }

  @media (max-width: 625px) {
    .movil {
      display: none;
    }

    #menuToggle {
      display: block;
      cursor: pointer;
    }

    #menuToggle:hover {
      font-size: 2.1rem;
    }

    #mobileMenu.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
      max-height: 500px; /* ajusta según contenido */
    }
    .separator {
      display: none;
    }
  }
</style>

<!-- JavaScript para alternar el menú -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const menuToggle = document.getElementById("menuToggle");
    const mobileMenu = document.getElementById("mobileMenu");

    console.log("no pasa", menuToggle, mobileMenu);
    // Verifica si existe el botón para alternar el menú
    if (!menuToggle || !mobileMenu) return;

    console.log("pasa");
    // Agregar evento de clic para mostrar/ocultar el menú
    menuToggle.addEventListener("click", function (event) {
      event.preventDefault(); // Evita el comportamiento predeterminado del enlace
      mobileMenu.classList.toggle("active"); // Alterna la clase 'active' en el menú
    });
  });
</script>
