---
// SVG en línea (no astro-icon): sus <use> compartidos no permiten animar el trazo
import logo from "../icons/franferrandez.svg?raw";

const svg = logo
  .replace(/<\?xml[^>]*>|<!DOCTYPE[^>]*>|<metadata>[\s\S]*?<\/metadata>/g, "")
  .replace(/\swidth="[^"]*"|\sheight="[^"]*"/g, "")
  .replace("<svg", '<svg class="intro-logo" focusable="false"');
---

<!-- Pantalla de entrada: solo visible si el <head> ha activado html.intro -->
<div id="intro" aria-hidden="true">
  <Fragment set:html={svg} />
</div>

<script is:inline>
  // Normaliza la longitud de cada trazo antes del primer pintado
  document.querySelectorAll("#intro path").forEach((p) => p.setAttribute("pathLength", "1"));
</script>

<style>
  #intro {
    display: none;
  }

  :global(html.intro) {
    overflow: hidden;
  }

  :global(html.intro) #intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: rgb(var(--bg));
    /* Se va sola aunque falle el JS */
    animation: intro-out 0.7s cubic-bezier(0.7, 0, 0.3, 1) 1.9s forwards;
  }

  #intro :global(.intro-logo) {
    width: clamp(88px, 18vw, 140px);
    height: auto;
    color: rgb(var(--fg));
    animation: logo-out 0.7s cubic-bezier(0.7, 0, 0.3, 1) 1.9s forwards;
  }

  #intro :global(.intro-logo path) {
    fill: rgb(var(--accent) / 0);
    stroke: rgb(var(--fg));
    stroke-width: 36;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.15s forwards,
      colorize 0.6s ease 1.15s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes colorize {
    to {
      fill: rgb(var(--accent));
      stroke: rgb(var(--accent));
    }
  }

  @keyframes logo-out {
    to {
      transform: scale(0.6);
      opacity: 0;
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<script>
  const intro = document.getElementById("intro")!;
  const root = document.documentElement;
  const finish = () => {
    if (!root.classList.contains("intro")) return;
    root.classList.remove("intro");
    window.dispatchEvent(new Event("intro:done"));
  };

  if (root.classList.contains("intro")) {
    intro.addEventListener("animationend", (e) => e.target === intro && finish());
    setTimeout(finish, 3200); // por si el navegador no dispara animationend
  }
</script>
