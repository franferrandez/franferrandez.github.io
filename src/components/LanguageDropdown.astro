---
import { Icon } from "astro-icon/components";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@i18n/utils";
import { languages } from "@i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="relative inline-block">
  <button id="languageButton" class="flex items-center rounded-lg ml-2">
    <Icon name="globe" class="w-5 h-5" />
  </button>
  <ul
    id="languageMenu"
    class="bg-amber-50 dark:bg-amber-700 shadow-md rounded-lg mt-2 min-w-[120px]"
  >
    {
      languages.map((language) => (
        <li>
          <a
            href={translatePath("/", language.code)}
            class="block px-4 py-2 hover:bg-amber-200 dark:hover:bg-amber-600 text-amber-800 dark:text-amber-200"
            data-lang={language.code}
          >
            {language.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  #languageMenu {
    list-style: none;
    padding: 0;
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    position: absolute;
    right: 0;
    z-index: 100;
  }

  #languageMenu.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (max-width: 625px) {
    #languageMenu {
      width: auto;
      min-width: 120px;
      right: auto;
      left: 50%;
      transform: translateX(-50%) translateY(-10px);
    }

    #languageMenu.show {
      transform: translateX(-50%) translateY(0);
    }
  }

  #languageButton {
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  #languageButton:hover {
    transform: scale(1.1);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const languageButton = document.getElementById("languageButton");
    const languageMenu = document.getElementById("languageMenu");

    if (!languageButton || !languageMenu) return; // Verificar que los elementos existen

    // Mostrar/ocultar el menú al hacer clic en el botón
    languageButton.addEventListener("click", () => {
      languageMenu.classList.toggle("show");
    });

    // Cerrar el menú si se hace clic fuera de él
    document.addEventListener("click", (event) => {
      if (
        !languageButton.contains(event.target as Node) &&
        !languageMenu.contains(event.target as Node)
      ) {
        languageMenu.classList.remove("show");
      }
    });

    // Evitar que el clic dentro del menú cierre el menú
    languageMenu.addEventListener("click", (event) => {
      event.stopPropagation();
    });
  });
</script>
