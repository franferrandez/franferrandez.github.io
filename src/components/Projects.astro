---
import SectionHeading from "./SectionHeading.astro";
import { getLangFromUrl, useContent } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const { projects } = useContent(lang);
---

<section id="projects" class="mx-auto max-w-page px-5 py-24 md:px-8 md:py-32">
  <SectionHeading index="03" title={projects.title} intro={projects.intro} />

  <div
    role="tablist"
    aria-label={projects.title}
    class="tablist -mx-5 mb-10 flex gap-1 overflow-x-auto border-b border-line px-5 md:mx-0 md:px-0"
    data-reveal
  >
    {
      projects.groups.map((group, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${group.id}`}
          aria-controls={`panel-${group.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="tab relative shrink-0 whitespace-nowrap px-4 pb-3 pt-1 text-sm text-muted transition-colors hover:text-fg"
        >
          {group.tab}
          <span class="ml-1.5 font-mono text-xs text-muted/70">{group.items.length}</span>
        </button>
      ))
    }
  </div>

  {
    projects.groups.map((group, i) => (
      <div
        role="tabpanel"
        id={`panel-${group.id}`}
        aria-labelledby={`tab-${group.id}`}
        class="panel"
        data-active={i === 0 ? "true" : "false"}
      >
        <div class="mb-8 max-w-3xl">
          {group.period && (
            <p class="mb-1 flex flex-wrap items-baseline gap-x-3">
              <span class="font-medium">{group.company}</span>
              <span class="font-mono text-xs text-accent">{group.period}</span>
            </p>
          )}
          <p class="text-muted">{group.note}</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((project, j) => {
            const Tag = "href" in project ? "a" : "div";
            const linkProps =
              "href" in project ? { href: project.href, target: "_blank", rel: "noopener noreferrer" } : {};
            return (
              <li class="card-wrap" style={`--i:${j}`}>
                <Tag
                  {...linkProps}
                  class="card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface p-6 transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-fg/25 md:p-7"
                >
                  <div class="mb-8 flex items-start justify-between">
                    <span class="font-mono text-xs text-muted">{String(j + 1).padStart(2, "0")}</span>
                    {"href" in project && (
                      <span class="font-mono text-xs text-accent opacity-80 transition-opacity group-hover:opacity-100">
                        {projects.source} ↗
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl font-semibold tracking-tight">{project.title}</h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{project.description}</p>
                  <p class="mt-6 border-t border-line pt-4 font-mono text-xs text-muted/80">
                    {project.stack.join(" · ")}
                  </p>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .tablist {
    scrollbar-width: none;
  }
  .tab[aria-selected="true"] {
    color: rgb(var(--fg));
  }
  .tab::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: rgb(var(--accent));
    transform: scaleX(0);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .tab[aria-selected="true"]::after {
    transform: scaleX(1);
  }

  /* Sin JS se ven todos los grupos seguidos */
  :global(.js) .panel[data-active="false"] {
    display: none;
  }
  :global(html:not(.js)) .panel + .panel {
    margin-top: 4rem;
  }

  .panel[data-active="true"] .card-wrap {
    animation: card-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 50ms);
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel[data-active="true"] .card-wrap {
      animation: none;
    }
  }

  /* Brillo que sigue al cursor */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      400px circle at var(--mx, 50%) var(--my, 50%),
      rgb(var(--accent) / 0.1),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .card:hover::before {
    opacity: 1;
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("#projects [role=tab]")];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute("aria-selected", String(active));
      t.tabIndex = active ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.dataset.active = String(active);
    }
    tab.scrollIntoView({ block: "nearest", inline: "nearest" });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    // Navegación con flechas entre pestañas
    tab.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });

  document.querySelectorAll<HTMLElement>("#projects .card").forEach((card) => {
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${e.clientX - r.left}px`);
      card.style.setProperty("--my", `${e.clientY - r.top}px`);
    });
  });
</script>
